        </createTable>
        <addUniqueConstraint tableName="dsm_connection" columnNames="account_id, peer_device_id"
                             constraintName="dsm_connection_peer_uniq"/>
        <addForeignKeyConstraint baseColumnNames="account_id" baseTableName="dsm_connection"
                                 constraintName="fk_dsm_connection_account" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id"
                                 referencedTableName="dsm_warehouse_account"/>
        <addForeignKeyConstraint baseColumnNames="peer_location_id" baseTableName="dsm_connection"
                                 constraintName="fk_dsm_connection_peer_location" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id" referencedTableName="location"/>
