<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog/1.9"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog/1.9 http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-1.9.xsd">

    <!--
    DSM custody (docs/plans/2026-11-01-dsm-custody-integration.md): each warehouse's own DSM account, the token
    that stands for a product's units, the DSM Connect session between two warehouses, and the record of each
    custody transfer a shipment made. See the domain classes in org.pih.warehouse.dsm.
    -->

    <changeSet author="cryptskii" id="011120261200-0">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dsm_warehouse_account"/>
            </not>
        </preConditions>
        <createTable tableName="dsm_warehouse_account">
            <column name="id" type="CHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="location_id" type="CHAR(38)">
                <constraints nullable="false" unique="true" uniqueConstraintName="dsm_warehouse_account_location_uniq"/>
            </column>
            <column name="ingress_origin" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="data_dir" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="device_id" type="CHAR(52)">
                <constraints nullable="false" unique="true" uniqueConstraintName="dsm_warehouse_account_device_uniq"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="last_updated" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="location_id" baseTableName="dsm_warehouse_account"
                                 constraintName="fk_dsm_warehouse_account_location" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id" referencedTableName="location"/>
    </changeSet>

    <changeSet author="cryptskii" id="011120261200-1">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dsm_product_token"/>
            </not>
        </preConditions>
        <createTable tableName="dsm_product_token">
            <column name="id" type="CHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="product_id" type="CHAR(38)">
                <constraints nullable="false" unique="true" uniqueConstraintName="dsm_product_token_product_uniq"/>
            </column>
            <column name="issuer_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="policy_anchor" type="CHAR(52)">
                <constraints nullable="false" unique="true" uniqueConstraintName="dsm_product_token_anchor_uniq"/>
            </column>
            <column name="ticker" type="VARCHAR(8)">
                <constraints nullable="false"/>
            </column>
            <column name="supply" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseColumnNames="product_id" baseTableName="dsm_product_token"
                                 constraintName="fk_dsm_product_token_product" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id" referencedTableName="product"/>
        <addForeignKeyConstraint baseColumnNames="issuer_id" baseTableName="dsm_product_token"
                                 constraintName="fk_dsm_product_token_issuer" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id"
                                 referencedTableName="dsm_warehouse_account"/>
    </changeSet>

    <changeSet author="cryptskii" id="011120261200-2">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dsm_warehouse_link"/>
            </not>
        </preConditions>
        <createTable tableName="dsm_warehouse_link">
            <column name="id" type="CHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="offering_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="accepting_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="CHAR(52)">
                <constraints nullable="false" unique="true" uniqueConstraintName="dsm_warehouse_link_session_uniq"/>
            </column>
            <column name="offer_digest" type="CHAR(52)">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="dsm_warehouse_link" columnNames="offering_id, accepting_id"
                             constraintName="dsm_warehouse_link_pair_uniq"/>
        <addForeignKeyConstraint baseColumnNames="offering_id" baseTableName="dsm_warehouse_link"
                                 constraintName="fk_dsm_warehouse_link_offering" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id"
                                 referencedTableName="dsm_warehouse_account"/>
        <addForeignKeyConstraint baseColumnNames="accepting_id" baseTableName="dsm_warehouse_link"
                                 constraintName="fk_dsm_warehouse_link_accepting" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id"
                                 referencedTableName="dsm_warehouse_account"/>
    </changeSet>

    <changeSet author="cryptskii" id="011120261200-3">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="dsm_custody_transfer"/>
            </not>
        </preConditions>
        <createTable tableName="dsm_custody_transfer">
            <column name="id" type="CHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="shipment_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="origin_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="destination_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="memo" type="VARCHAR(256)">
                <constraints nullable="false"/>
            </column>
            <column name="origin_state_hash" type="CHAR(52)">
                <constraints nullable="false" unique="true" uniqueConstraintName="dsm_custody_transfer_origin_state_uniq"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="date_established" type="DATETIME"/>
            <column name="destination_transfer_id" type="VARCHAR(255)"/>
            <column name="proven_amount" type="BIGINT"/>
            <column name="proven_position" type="BIGINT"/>
        </createTable>
        <addUniqueConstraint tableName="dsm_custody_transfer" columnNames="shipment_id, product_id"
                             constraintName="dsm_custody_transfer_shipment_product_uniq"/>
        <addForeignKeyConstraint baseColumnNames="shipment_id" baseTableName="dsm_custody_transfer"
                                 constraintName="fk_dsm_custody_transfer_shipment" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id" referencedTableName="shipment"/>
        <addForeignKeyConstraint baseColumnNames="product_id" baseTableName="dsm_custody_transfer"
                                 constraintName="fk_dsm_custody_transfer_product" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id" referencedTableName="product"/>
        <addForeignKeyConstraint baseColumnNames="origin_id" baseTableName="dsm_custody_transfer"
                                 constraintName="fk_dsm_custody_transfer_origin" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id"
                                 referencedTableName="dsm_warehouse_account"/>
        <addForeignKeyConstraint baseColumnNames="destination_id" baseTableName="dsm_custody_transfer"
                                 constraintName="fk_dsm_custody_transfer_destination" deferrable="false"
                                 initiallyDeferred="false" referencedColumnNames="id"
                                 referencedTableName="dsm_warehouse_account"/>
    </changeSet>
</databaseChangeLog>
