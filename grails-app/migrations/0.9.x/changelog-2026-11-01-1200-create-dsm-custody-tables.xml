        <createTable tableName="dsm_connection">
            <column name="id" type="CHAR(38)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="account_id" type="CHAR(38)">
                <constraints nullable="false"/>
            </column>
            <column name="peer_device_id" type="CHAR(52)">
                <constraints nullable="false"/>
            </column>
            <column name="peer_location_id" type="CHAR(38)"/>
            <column name="peer_registry" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="peer_name" type="VARCHAR(255)"/>
            <column name="side" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="CHAR(52)">
                <constraints nullable="false"/>
            </column>
            <column name="offer_digest" type="CHAR(52)">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="DATETIME">
                <constraints nullable="false"/>
